:root {
   --logo-alfa: 1;
   --logo-size: 35px;
   --logo-bold: 10px;
   --logo-color: wheat; /* #61DAFB */
   --logo-arch: 9px;
   --speed: 333ms;
} 

logo {
   display: inline-block;
   position: relative;
   width: var(--logo-size);
   height: var(--logo-size);
   color: var(--logo-color);
   box-sizing: border-box;
   perspective: 50000px;
}

logo:hover {
   & * { opacity: var(--logo-alfa); }
   & div:nth-child(1) { animation: loop-1 var(--speed) linear infinite; }
   & div:nth-child(2) { animation: loop-2 var(--speed) linear infinite; }
   & div:nth-child(3) { animation: loop-3 var(--speed) linear infinite; }
   background-image: url('');
}

logo > div {
   width: 100%;
   height: 100%;
   position: absolute;
   border-left: var(--logo-bold) solid;
   border-top: var(--logo-bold) solid transparent;
   border-radius: 100%;
}

logo > span {
   top: 63%;
   left: 63%;
   display: block;
   position: absolute;
   border-radius: 100%;
   width: var(--logo-arch);
   height: var(--logo-arch);
   transform: translate(-50%, -50%);
   background: currentColor;
   /* animation: pulse 700ms infinite; */
 }

@keyframes loop-1 {
   0% {
      opacity: var(--logo-alfa);
      transform: rotateZ(120deg) rotateX(66deg) rotateZ(0deg);
   }
   1% { opacity: 1; }
   100% {
      transform: rotateZ(120deg) rotateX(66deg) rotateZ(360deg);
   }
}

@keyframes loop-2 {
   0% {
      opacity: var(--logo-alfa);
      transform: rotateZ(60deg) rotateX(66deg) rotateZ(0deg);
   }
   20% { opacity: 1; }
   100% {
      transform: rotateZ(60deg) rotateX(66deg) rotateZ(360deg);
   }
}

@keyframes loop-3 {
   0% {
      opacity: var(--logo-alfa);
      transform: rotateZ(0deg) rotateX(66deg) rotateZ(0deg);
   }
   40% { opacity: 1; }
   100% {
      transform: rotateZ(0deg) rotateX(66deg) rotateZ(360deg);
   }
}

@keyframes pulse {
   0% {       
      transform: scale(1) translateX(-35%) translateY(-30%);
      opacity: 1; 
   }
   50% {       
      transform: scale(1.3) translateX(-35%) translateY(-30%);
      opacity: 1; 
   }
   100% { 
      transform: scale(1.5) translateX(-35%) translateY(-30%);
      opacity: 0.5; 
   }
 }
 nav {
